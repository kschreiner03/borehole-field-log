{
  "name": "borehole-field-log",
  "productName": "Borehole Field Log",
  "version": "0.2.0",
  "description": "Borehole logging, groundwater and reporting for Alberta and Saskatchewan consultants",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "sync-legacy": "node scripts/sync-legacy.mjs",
    "fetch-mf6": "node scripts/fetch-mf6.mjs",
    "dev": "npm run sync-legacy && node scripts/dev.mjs",
    "build": "npm run sync-legacy && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:app": "npm run sync-legacy && node scripts/test-app.mjs",
    "package:win": "node scripts/fetch-mf6.mjs win32-x64 && npm run build && electron-builder --win",
    "package:mac": "node scripts/fetch-mf6.mjs darwin-arm64 && npm run build && electron-builder --mac",
    "dist:win": "node scripts/fetch-mf6.mjs win32-x64 && npm test && npm run test:app && npm run build && electron-builder --win",
    "release": "node scripts/release.mjs",
    "dist:mac": "node scripts/fetch-mf6.mjs darwin-arm64 && npm test && npm run test:app && npm run build && APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-borehole-notary} electron-builder --mac"
  },
  "build": {
    "appId": "ca.boreholefieldlog.app",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "productName": "Borehole Field Log",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**",
      "!resources/mf6/**",
      "resources/mf6/NOTICE.md"
    ],
    "extraResources": [
      {
        "from": "build/privacy-policy.txt",
        "to": "privacy-policy.txt"
      }
    ],
    "asarUnpack": [
      "resources/mf6/**"
    ],
    "fileAssociations": [
      {
        "ext": "bhp",
        "name": "Borehole project",
        "role": "Editor"
      },
      {
        "ext": "bhlog",
        "name": "Borehole workspace",
        "role": "Editor"
      },
      {
        "ext": "bh",
        "name": "Borehole",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "files": [
        "resources/mf6/win32-x64/**"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "files": [
        "resources/mf6/darwin-arm64/**"
      ],
      "gatekeeperAssess": false,
      "identity": "KOLE KRISTIAN SCHREINER (UUUUG5QGQ9)",
      "notarize": true,
      "artifactName": "Borehole-Field-Log-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Borehole Field Log",
      "uninstallDisplayName": "Borehole Field Log",
      "artifactName": "Borehole-Field-Log-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "license": "build/privacy-policy.txt",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "installerHeader": "build/installer-header.bmp"
    }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
